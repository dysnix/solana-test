{
  "name": "solana-rpc-load-test",
  "version": "2.0.0",
  "description": "Robust load testing tool for Solana RPC endpoints",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "pretest": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "health-check": "ts-node src/health-check-cli.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@types/bs58": "^4.0.4",
    "axios": "^1.6.0",
    "bs58": "^6.0.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "tweetnacl": "^1.0.3",
    "typescript-eslint": "^8.56.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "solana",
    "rpc",
    "load-test",
    "performance",
    "testing",
    "benchmark"
  ],
  "author": "Vladyslav Deryhin",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dysnix/solana-test.git"
  }
}
